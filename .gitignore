/.playwright-cli/
/.playwright-mcp/
/test-results/
/playwright-report/
/coverage/

# Local ad-hoc verification output (screenshots, captures) not meant to be versioned.
/output/

# Local doc assets that are not meant to be versioned.
/docs/assets/

# Internal engineering notes (migration plans, QA logs, size baselines) — kept
# locally for reference but not meant for the public repo alongside user docs.
/docs/internal/

# Local-only scratch: one-off audit reports, ad-hoc test fixtures, and rendered
# showcase artifacts (the .md sources they were generated from live in docs/).
# Kept out of the repo so the root stays legible — none of it is a build input.
/selfdocs/

# Draft for an unrelated product concept, kept locally for reference only —
# not part of Xiangzi MD and must never be committed to this repo.
/docs/AI_PROJECT_MEMORY_PRODUCT_CONCEPT.md

# Local design-review notes.
/design-qa.md

# English feature copy drafted for the marketing site, not for this repo.
/docs/WEBSITE_FEATURE_*_EN.md
/docs/WEBSITE_FUNCTIONS_EN.md

# HarmonyOS port: in-progress ArkTS rewrite kept local for now, along with its
# migration plan. Nothing here is a build input for the desktop app.
/docs/harmonyos-migration.md
/harmonyos/
